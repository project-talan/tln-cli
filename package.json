{
  "name": "tln-cli",
  "version": "2.0.0-alpha",
  "description": "SDLC framework",
  "bin": {
    "tln2": "./dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js && node -e \"require('fs').cpSync('src/components', 'dist/components', { recursive: true })\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "dev:debug": "node --inspect-brk --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-talan/tln-cli.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "vladislav.kurmaz@gmail.com",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/project-talan/tln-cli/issues"
  },
  "homepage": "https://github.com/project-talan/tln-cli#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "find-up": "^8.0.0",
    "yaml": "^2.9.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
